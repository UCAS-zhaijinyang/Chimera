ual math is implemented by mean_values()\nin src/helper.py and imported/used here.\n\"\"\"\n\ntry:  # Package-style import (src is a package / imported as src.main).\n    from .helper import mean_values\nexcept ImportError:  # Fallback: src itself is on sys.path (checks/tests).\n    from helper import mean_values\n\n__all__ = [\"compute\"]\n\n\ndef compute(a, b):\n    \"\"\"Return the arithmetic mean of two finite numeric inputs.\n\n    Delegates to mean_values() from src/helper.py. Supports zero, negative\n    and fractional values; the result is always a float, so compute(2, 3)\n    returns 2.5.\n\n    Raises:\n        TypeError: if a or b is not an int/float (bool is rejected too).\n        ValueError: if a or b is NaN or +/- infinity.\n    \"\"\"\n    return mean_values(a, b)\n", "output_paths_kind": "read_only_capture_evidence", "business_path": "src/main.py", "workspace": "/Users/ayang/Desktop/project_work/Chimera/docs/dataset-evaluation/reports/stage2/full-from-scratch-20261015/q2-q3/failure-rerun-20261016/tasks/q2-t0413/study/workspaces/retry-q2-t0413-t0001", "execution_environment": {"cwd": "/Users/ayang/Desktop/project_work/Chimera/docs/dataset-evaluation/reports/stage2/full-from-scratch-20261015/q2-q3/failure-rerun-20261016/tasks/q2-t0413/study/workspaces/retry-q2-t0413-t0001", "python_executable": "/opt/anaconda3/bin/python", "default_build_command": "/opt/anaconda3/bin/python -m compileall -q src", "build_kind": "python_bytecode_compilation", "optional_modules": {"pytest": true, "build": false, "pip": true, "setuptools": true}}}, "status": "success", "schema_version": "chimera-event/1", "event_seq": 17, "event_id": "9757e4d6076d43e8a01ca28a4ef0a595", "wall_time_utc": "2026-10-16T07:52:24.136197+00:00", "simulation_clock_kind": "task_start_plus_logical_order"}
